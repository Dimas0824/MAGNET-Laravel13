# syntax: Caddyfile
{
    auto_https off
    frankenphp
}

http://:80 {
    root * /app/public
    encode gzip zstd

    @static {
        file
        path *.css *.js *.jpg *.jpeg *.png *.gif *.svg *.ico *.woff *.woff2 *.ttf *.map
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    php_server
}
